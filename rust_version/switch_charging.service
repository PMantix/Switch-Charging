[Unit]
Description=Switch Charging Controller
After=multi-user.target

[Service]
Type=simple
ExecStart=/home/pi/Switch-Charging/rust_version/target/release/switch_charging
WorkingDirectory=/home/pi/Switch-Charging/rust_version
Environment="RUST_LOG=info"
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
